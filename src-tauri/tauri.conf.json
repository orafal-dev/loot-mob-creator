{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loot Creator",
  "version": "1.0.14",
  "identifier": "com.rafalolszewski.loot-mob-creator",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loot Mob Creator",
        "width": 1040,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGMUY3OTY1QkNCMTA2NDAKUldSQUJyRzhaWGtmbnhEejMzV0Z1WWUrOFFlMktJcW1VY1phY2pIampvSjllWUFMLzNTU2N4ck0K",
      "endpoints": [
        "https://github.com/orafal-dev/loot-mob-creator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
